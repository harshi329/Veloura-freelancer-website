# Veloura Environment Configuration Template
# Copy to .env and fill in your values. NEVER commit .env to source control!

PORT=5000
NODE_ENV=development

# Database Connection URI (use MongoDB Atlas for production deployment)
MONGODB_URI=mongodb://127.0.0.1:27017/veloura
MONGODB_TEST_URI=mongodb://127.0.0.1:27017/veloura_test

# Authentication JWT Secret (REQUIRED in production, minimum 32 characters)
JWT_SECRET=your-random-32-char-secret-do-not-use-in-production

# Client & App URLs
CLIENT_ORIGIN=http://localhost:5000
APP_URL=http://localhost:5000
OAUTH_REDIRECT_BASE=http://localhost:5000

# Seeding Demo Data (only seeds if set to true)
SEED_DEMO_DATA=false

# OAuth Providers (Optional - setup in Google Cloud & GitHub developer consoles)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email Delivery via Resend (Optional - if omitted, password resets log to console in dev)
RESEND_API_KEY=
EMAIL_FROM=Veloura <onboarding@resend.dev>
